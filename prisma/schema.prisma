model AnimalFarmerRegistration {
  id                     String                  @id @default(uuid())
  farmerId               String
  animalId               String
  totalNumber            Int
  maleNumber             Int
  femaleNumber           Int
  farmer                 Farmer                  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  animal                 Animal                  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  liveStockRegistrations LiveStockRegistration[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model LiveStockRegistration {
  id                              String                            @id @default(uuid())
  animalFarmerRegistrationId      String
  breedId                         String
  weight                          Int
  weightMeasurement               String
  animalState                     AnimalState
  dob                             DateTime
  animalFarmerRegistration        AnimalFarmerRegistration          @relation(fields: [animalFarmerRegistrationId], references: [id], onDelete: Cascade)
  breed                           Breed                             @relation(fields: [breedId], references: [id], onDelete: Cascade)
  liveStockVaccinations           LiveStockVaccination[]
  liveStockVitamins               LiveStockVitamins[]
  farmerAnimalRegistrationProduce FarmerAnimalRegistrationProduce[]
  purpose                         Purpose
  slaughterAnimalRegistration     SlaughterAnimalRegistration?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
}

