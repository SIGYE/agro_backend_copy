model FarmerAnimalRegistrationProduce {
  id                         String                   @id @default(uuid())
  LivestockRegistrationId String
  animalProductId            String
  amount                     Int
  measurements               String
  animalFarmerRegistration   LiveStockRegistration @relation(fields: [LivestockRegistrationId], references: [id])
  animalProduct              AnimalProduct            @relation(fields: [animalProductId], references: [id])
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model Breed {
  id                           String                        @id @default(uuid())
  animalId                     String
  breedName                    String
  animal                       Animal                        @relation(fields: [animalId], references: [id])
  liveStockRegistrations       LiveStockRegistration[]
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model SlaughterAnimalRegistration {
  id                     String                  @id @default(uuid())
  animalId               String
  liveStockId            String                  @unique
  breedId                String
  slaughterHouse         String
  age                    Int
  weight                 Int
  healthStatus           HealthStatus
  animal                 Animal                  @relation(fields: [animalId], references: [id])
  liveStock              LiveStockRegistration   @relation(fields: [liveStockId], references: [id])
  breed                  Breed                   @relation(fields: [breedId], references: [id])
  slaughterHouseRelation SlaughterHouse          @relation(fields: [slaughterHouse], references: [id])
  slaughterRegistrations SlaughterRegistration[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model SlaughterRegistration {
  id                            String                      @id @default(uuid())
  slaughterAnimalRegistrationId String
  slaughterDate                 DateTime
  preSlaughterWeight            Int
  postSlaughterWeight           Int
  slaughterAnimalRegistration   SlaughterAnimalRegistration @relation(fields: [slaughterAnimalRegistrationId], references: [id])
  animalSlaughterProducts       AnimalSlaughterProduct[]
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model SlaughterProducts {
  id                      String                   @id @default(uuid())
  productName             String
  animalSlaughterProducts AnimalSlaughterProduct[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model AnimalSlaughterProduct {
  id                      String                @id @default(uuid())
  slaughterRegistrationId String
  productId               String
  slaughterRegistration   SlaughterRegistration @relation(fields: [slaughterRegistrationId], references: [id])
  product                 SlaughterProducts     @relation(fields: [productId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model Agronomy {
  id            String   @id @default(uuid())
  userId        String
  locationName  String
  locationLevel Int
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Veterinary {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Umufashamyumvire {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HarvestSeason{
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  seasons   Season[]
  seasonStatus SeasonStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeedStrain{
  id        String   @id @default(uuid())
  name      String
  cropTypeId String
  cropType   CropType @relation(fields: [cropTypeId], references: [id])
  seasons   Season[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Harvest{
  id        String   @id @default(uuid())
  name      String
  amount    Float
  harvestDate DateTime
  seasonId  String
  season    Season @relation(fields: [seasonId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}

model Metric {
  id        String   @id @default(uuid())
  name      String
  unit      String
  seasons   Season[]
  metricType MetricType?
  baseMetricId String?
  baseMetric   Metric?  @relation("MetricToBaseMetric", fields: [baseMetricId], references: [id])
  derivedMetrics Metric[] @relation("MetricToBaseMetric")
  coefficient   Float?
  cropFertilizerFarmerRegistration CropFertilizerFarmerRegistration[]
  FarmingActivity FarmingActivity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model FarmingActivity{
  id        String   @id @default(uuid())
  date      DateTime
  activity  Activities
  seasonId  String
  season    Season @relation(fields: [seasonId], references: [id])
  medicines Medicine[]
  vaccines Vaccine[]
  fertilizers Feterlizer[]
  diseases     Disease[]
  pests        Pest[]
  metrics Metric[]
  amount     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Medicine{
  id        String   @id @default(uuid())
  name      String
  cropMedicines     CropMedicine[]
  animalMedicines   AnimalMedicine[]
  farmingActivities FarmingActivity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Vaccine{
  id        String   @id @default(uuid())
  name      String
  animalVaccines AnimalVaccine[]
  farmingActivities FarmingActivity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CropMedicine{
  id        String   @id @default(uuid())
  cropId    String
  crop      Crop @relation(fields: [cropId], references: [id])
  medicineId String
  medicine  Medicine @relation(fields: [medicineId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AnimalMedicine{
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal @relation(fields: [animalId], references: [id])
  medicineId String
  medicine  Medicine @relation(fields: [medicineId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}
model AnimalVaccine{
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal @relation(fields: [animalId], references: [id])
  vaccineId String
  vaccine   Vaccine @relation(fields: [vaccineId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum Activities{
  VACCINATION
  VITAMIN
  MEDICINE
  FERTILIZATION
  MEDICATION

}
enum MetricType{
  STANDARD
  DERIVED
}