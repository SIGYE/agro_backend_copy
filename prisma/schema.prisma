model LiveStockVaccination {
  id                      String                @id @default(uuid())
  liveStockRegistrationId String
  vaccinationId           String
  liveStockRegistration   LiveStockRegistration @relation(fields: [liveStockRegistrationId], references: [id], onDelete: Cascade)
  vaccination             Vaccination           @relation(fields: [vaccinationId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model LiveStockVitamins {
  id                      String                @id @default(uuid())
  liveStockRegistrationId String
  vitaminsId              String
  liveStockRegistration   LiveStockRegistration @relation(fields: [liveStockRegistrationId], references: [id], onDelete: Cascade)
  vitamins                Vitamin               @relation(fields: [vitaminsId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

