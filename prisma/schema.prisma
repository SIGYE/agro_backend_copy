generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum HealthStatus {
  HEALTHY
  SICK
  RECOVERING
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum Purpose {
  DAIRY
  MEAT
  WORK
  OTHER
}

model User {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  username          String             @unique
  email             String?            @unique
  telephone         String?            @unique
  firstName         String
  lastName          String
  nationalId        String?            @unique
  password          String
  otp               String?
  code              String?
  isDefaultPassword Boolean            @default(false)
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  status            Status             @default(ACTIVE)
  resetCodeExpires  DateTime?
  location          Location           @relation(fields: [locationId], references: [id])
  locationId        Int
  farmer            Farmer[]
  agronomies        Agronomy[]
  veterinaries      Veterinary[]
  umufashamyumvire  Umufashamyumvire[]

  diseases     Disease[]     @relation("DiseaseCreatedBy")
  vaccinations Vaccination[] @relation("VaccinationCreatedBy")
  vitamins     Vitamin[]     @relation("VitaminCreatedBy")
  feterlizers  Feterlizer[]  @relation("FeterlizerCreatedBy")
  crops        Crop[]        @relation("CropCreatedBy")
  animals      Animal[]      @relation("AnimalCreatedBy")

  @@map("user")
}

model Role {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique
  users     User[]

  @@map("role")
}

model locationLevel {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order_number Int
  name         String     @unique
  code         String     @unique
  locations    Location[]

  @@map("location_level")
}

model Location {
  id                Int           @id @default(autoincrement())
  createdAt         DateTime?     @default(now())
  updatedAt         DateTime?     @updatedAt
  locationId        Int?
  parentLocation    Location?     @relation("LocationToLocation", fields: [locationId], references: [id], onDelete: Cascade)
  childrenLocations Location[]    @relation("LocationToLocation")
  name              String
  locationLevel     locationLevel @relation(fields: [locationLevelId], references: [id], onDelete: Cascade)
  locationLevelId   Int
  users             User[]

  @@map("location")
}

model Disease {
  id                String             @id @default(uuid())
  name              String
  createdBy         String
  creator           User               @relation("DiseaseCreatedBy", fields: [createdBy], references: [id])
  liveStockDiseases LiveStockDisease[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Vaccination {
  id                    String                 @id @default(uuid())
  name                  String
  createdBy             String
  creator               User                   @relation("VaccinationCreatedBy", fields: [createdBy], references: [id])
  liveStockVaccinations LiveStockVaccination[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Vitamin {
  id                String              @id @default(uuid())
  name              String
  createdBy         String
  creator           User                @relation("VitaminCreatedBy", fields: [createdBy], references: [id])
  liveStockVitamins LiveStockVitamins[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Feterlizer {
  id                                     String                                  @id @default(uuid())
  name                                   String
  createdBy                              String
  creator                                User                                    @relation("FeterlizerCreatedBy", fields: [createdBy], references: [id])
  cropFertilizerFarmerRegistrations      CropFertilizerFarmerRegistration[]
  cropFertilizerCooperativeRegistrations CropFertilizerCooperativeRegistration[]
  createdAt                              DateTime                                @default(now())
  updatedAt                              DateTime                                @updatedAt
}

model Crop {
  id                           String                        @id @default(uuid())
  name                         String
  createdBy                    String
  creator                      User                          @relation("CropCreatedBy", fields: [createdBy], references: [id])
  cropFarmerRegistrations      CropFarmerRegistration[]
  cooperativeCropRegistrations CooperativeCropRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model Animal {
  id                             String                          @id @default(uuid())
  name                           String
  purpose                        Purpose
  createdBy                      String
  creator                        User                            @relation("AnimalCreatedBy", fields: [createdBy], references: [id])
  animalProducts                 AnimalProduct[]
  animalFarmerRegistrations      AnimalFarmerRegistration[]
  cooperativeAnimalRegistrations CooperativeAnimalRegistration[]
  slaughterAnimalRegistrations   SlaughterAnimalRegistration[]
  breeds                         Breed[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model AnimalProduct {
  id                                    String                                 @id @default(uuid())
  name                                  String
  animalId                              String
  animal                                Animal                                 @relation(fields: [animalId], references: [id])
  cooperativeAnimalRegistrationProduces CooperativeAnimalRegistrationProduce[]
  farmerAnimalRegistrationProduces      FarmerAnimalRegistrationProduce[]
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
}

model Farmer {
  id                        String                     @id @default(uuid())
  userId                    String                     @unique
  user                      User                       @relation(fields: [userId], references: [id])
  cropFarmerRegistrations   CropFarmerRegistration[]
  animalFarmerRegistrations AnimalFarmerRegistration[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Cooperative {
  id                             String                          @id @default(uuid())
  name                           String
  telephone                      String
  registationNumber              String
  membersNumber                  Int
  cooperativeCropRegistrations   CooperativeCropRegistration[]
  cooperativeAnimalRegistrations CooperativeAnimalRegistration[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model SlaughterHouse {
  id                           String                        @id @default(uuid())
  name                         String
  telephone                    String
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model CropFarmerRegistration {
  id                                String                             @id @default(uuid())
  farmerId                          String
  cropId                            String
  plantationArea                    String
  seeds                             String
  produceHarvested                  String
  farmer                            Farmer                             @relation(fields: [farmerId], references: [id])
  crop                              Crop                               @relation(fields: [cropId], references: [id])
  cropFertilizerFarmerRegistrations CropFertilizerFarmerRegistration[]
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
}

model CropFertilizerFarmerRegistration {
  id                       String                 @id @default(uuid())
  fertilizerId             String
  cropFarmerRegistrationId String
  amount                   Int
  measurement              String
  feterlizer               Feterlizer             @relation(fields: [fertilizerId], references: [id])
  cropFarmerRegistration   CropFarmerRegistration @relation(fields: [cropFarmerRegistrationId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model CooperativeCropRegistration {
  id                                     String                                  @id @default(uuid())
  cooperativeId                          String
  cropId                                 String
  plantationArea                         String
  seeds                                  String
  produceHarvested                       String
  cooperative                            Cooperative                             @relation(fields: [cooperativeId], references: [id])
  crop                                   Crop                                    @relation(fields: [cropId], references: [id])
  cropFertilizerCooperativeRegistrations CropFertilizerCooperativeRegistration[]
  createdAt                              DateTime                                @default(now())
  updatedAt                              DateTime                                @updatedAt
}

model CropFertilizerCooperativeRegistration {
  id                            String                      @id @default(uuid())
  fertilizerId                  String
  cooperativeCropRegistrationId String
  amount                        Int
  measurement                   String
  feterlizer                    Feterlizer                  @relation(fields: [fertilizerId], references: [id])
  cooperativeCropRegistration   CooperativeCropRegistration @relation(fields: [cooperativeCropRegistrationId], references: [id])
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model AnimalFarmerRegistration {
  id                              String                            @id @default(uuid())
  farmerId                        String
  animalId                        String
  totalNumber                     Int
  maleNumber                      Int
  femaleNumber                    Int
  farmer                          Farmer                            @relation(fields: [farmerId], references: [id])
  animal                          Animal                            @relation(fields: [animalId], references: [id])
  liveStockRegistrations          LiveStockRegistration[]
  farmerAnimalRegistrationProduce FarmerAnimalRegistrationProduce[]
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
}

model LiveStockRegistration {
  id                          String                       @id @default(uuid())
  animalFarmerRegistrationId  String
  breedId                     String
  weight                      Int
  weightMeasurement           String
  produce                     Float
  produceMeasurement          String
  dob                         DateTime
  animalFarmerRegistration    AnimalFarmerRegistration     @relation(fields: [animalFarmerRegistrationId], references: [id])
  breed                       Breed                        @relation(fields: [breedId], references: [id])
  liveStockDiseases           LiveStockDisease[]
  liveStockVaccinations       LiveStockVaccination[]
  liveStockVitamins           LiveStockVitamins[]
  slaughterAnimalRegistration SlaughterAnimalRegistration?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

model LiveStockDisease {
  id                      String                @id @default(uuid())
  liveStockRegistrationId String
  diseaseId               String
  liveStockRegistration   LiveStockRegistration @relation(fields: [liveStockRegistrationId], references: [id])
  disease                 Disease               @relation(fields: [diseaseId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model LiveStockVaccination {
  id                      String                @id @default(uuid())
  liveStockRegistrationId String
  vaccinationId           String
  liveStockRegistration   LiveStockRegistration @relation(fields: [liveStockRegistrationId], references: [id])
  vaccination             Vaccination           @relation(fields: [vaccinationId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model LiveStockVitamins {
  id                      String                @id @default(uuid())
  liveStockRegistrationId String
  vitaminsId              String
  liveStockRegistration   LiveStockRegistration @relation(fields: [liveStockRegistrationId], references: [id])
  vitamins                Vitamin               @relation(fields: [vitaminsId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model CooperativeAnimalRegistration {
  id                                    String                                 @id @default(uuid())
  cooperativeId                         String
  animalId                              String
  totalNumber                           Int
  maleNumber                            Int
  femaleNumber                          Int
  cooperative                           Cooperative                            @relation(fields: [cooperativeId], references: [id])
  animal                                Animal                                 @relation(fields: [animalId], references: [id])
  cooperativeAnimalRegistrationProduces CooperativeAnimalRegistrationProduce[]
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
}

model CooperativeAnimalRegistrationProduce {
  id                              String                        @id @default(uuid())
  cooperativeAnimalRegistrationId String
  animalProductId                 String
  amount                          Int
  measurements                    String
  cooperativeAnimalRegistration   CooperativeAnimalRegistration @relation(fields: [cooperativeAnimalRegistrationId], references: [id])
  animalProduct                   AnimalProduct                 @relation(fields: [animalProductId], references: [id])
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
}

model FarmerAnimalRegistrationProduce {
  id                         String                   @id @default(uuid())
  animalFarmerRegistrationId String
  animalProductId            String
  amount                     Int
  measurements               String
  animalFarmerRegistration   AnimalFarmerRegistration @relation(fields: [animalFarmerRegistrationId], references: [id])
  animalProduct              AnimalProduct            @relation(fields: [animalProductId], references: [id])
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model Breed {
  id                           String                        @id @default(uuid())
  animalId                     String
  breedName                    String
  animal                       Animal                        @relation(fields: [animalId], references: [id])
  liveStockRegistrations       LiveStockRegistration[]
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model SlaughterAnimalRegistration {
  id                     String                  @id @default(uuid())
  animalId               String
  liveStockId            String                  @unique
  breedId                String
  slaughterHouse         String
  age                    Int
  weight                 Int
  healthStatus           HealthStatus
  animal                 Animal                  @relation(fields: [animalId], references: [id])
  liveStock              LiveStockRegistration   @relation(fields: [liveStockId], references: [id])
  breed                  Breed                   @relation(fields: [breedId], references: [id])
  slaughterHouseRelation SlaughterHouse          @relation(fields: [slaughterHouse], references: [id])
  slaughterRegistrations SlaughterRegistration[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model SlaughterRegistration {
  id                            String                      @id @default(uuid())
  slaughterAnimalRegistrationId String
  slaughterDate                 DateTime
  preSlaughterWeight            Int
  postSlaughterWeight           Int
  slaughterAnimalRegistration   SlaughterAnimalRegistration @relation(fields: [slaughterAnimalRegistrationId], references: [id])
  animalSlaughterProducts       AnimalSlaughterProduct[]
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model SlaughterProducts {
  id                      String                   @id @default(uuid())
  productName             String
  animalSlaughterProducts AnimalSlaughterProduct[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model AnimalSlaughterProduct {
  id                      String                @id @default(uuid())
  slaughterRegistrationId String
  productId               String
  slaughterRegistration   SlaughterRegistration @relation(fields: [slaughterRegistrationId], references: [id])
  product                 SlaughterProducts     @relation(fields: [productId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model Agronomy {
  id            String   @id @default(uuid())
  userId        String
  locationName  String
  locationLevel Int
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Veterinary {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Umufashamyumvire {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
