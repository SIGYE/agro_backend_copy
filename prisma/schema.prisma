generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}
  enum CooperativeType{
    ITSINDA
    COOPERATIVE
  }
  enum HealthStatus {
    HEALTHY
    SICK
    RECOVERING
    OTHER
  }

enum Gender {
  MALE
  FEMALE
}

enum Purpose {
  DAIRY
  MEAT
  WORK
  OTHER
}

enum PestType{
  LIVESTOCK
  CROP
}
enum DiseaseType{
  LIVESTOCK
  CROP
}
enum AnimalState{
  HEALTHY
  SICK
  SLAUGHTERED
  DEAD

}
enum SeasonStatus{
  ON_GOING
  ENDED
}

model User {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  username          String             @unique
  email             String?            @unique
  telephone         String?            @unique
  firstName         String
  lastName          String
  gender            Gender?
  dob               DateTime?
  nationalId        String?            @unique
  password          String
  otp               String?
  code              String?
  isDefaultPassword Boolean            @default(false)
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  status            Status             @default(ACTIVE)
  resetCodeExpires  DateTime?
  location          Location?           @relation(fields: [locationId], references: [id])
  locationId        Int?
  country           Int?
  farmer            Farmer[]
  agronomies        Agronomy[]
  veterinaries      Veterinary[]
  umufashamyumvire  Umufashamyumvire[]
  slaughters        SlaughterHouse[]
  cooperativeManager Cooperative[]
  locationChildrenIds  String?

  diseases     Disease[]     @relation("DiseaseCreatedBy")
  pests        Pest[]        @relation("PestCreatedBy")
  vaccinations Vaccination[] @relation("VaccinationCreatedBy")
  vitamins     Vitamin[]     @relation("VitaminCreatedBy")
  feterlizers  Feterlizer[]  @relation("FeterlizerCreatedBy")
  crops        Crop[]        @relation("CropCreatedBy")
  animals      Animal[]      @relation("AnimalCreatedBy")

  @@map("user")
}

model Role {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique
  users     User[]

  @@map("role")
}

model locationLevel {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order_number Int
  name         String     @unique
  code         String     @unique
  locations    Location[]

  @@map("location_level")
}

model Location {
  id                Int           @id @default(autoincrement())
  createdAt         DateTime?     @default(now())
  updatedAt         DateTime?     @updatedAt
  locationId        Int?
  parentLocation    Location?     @relation("LocationToLocation", fields: [locationId], references: [id], onDelete: Cascade)
  childrenLocations Location[]    @relation("LocationToLocation")
  name              String
  locationLevel     locationLevel @relation(fields: [locationLevelId], references: [id], onDelete: Cascade)
  locationLevelId   Int
  users             User[]
  cooperatives      Cooperative[]
  locationLevelName  Location_Level_Name[]

  @@map("location")
}
model Location_Level_Name{
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order_number Int
  countryId    Int
  country Location @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name         String     
  code         String     
}

model Disease {
  id                String             @id @default(uuid())
  name              String
  createdBy         String
  creator           User               @relation("DiseaseCreatedBy", fields: [createdBy], references: [id])
  animals        LiveStockRegistration[]
  crops             Crop[]
  seasons           Season[]
  type              DiseaseType
  farmingActivities FarmingActivity[]
  medication        String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}
model Pest{
  id                String             @id @default(uuid())
  name              String
  createdBy         String
  creator           User               @relation("PestCreatedBy", fields: [createdBy], references: [id])
  animals         LiveStockRegistration[]
  crops             Crop[]
  seasons           Season[]
  farmingActivities FarmingActivity[]
  type              PestType
  medication        String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

}

model Vaccination {
  id                    String                 @id @default(uuid())
  name                  String
  createdBy             String
  creator               User                   @relation("VaccinationCreatedBy", fields: [createdBy], references: [id])
  liveStockVaccinations LiveStockVaccination[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Vitamin {
  id                String              @id @default(uuid())
  name              String
  createdBy         String
  creator           User                @relation("VitaminCreatedBy", fields: [createdBy], references: [id])
  liveStockVitamins LiveStockVitamins[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Feterlizer {
  id                                     String                                  @id @default(uuid())
  name                                   String
  createdBy                              String
  creator                                User                                    @relation("FeterlizerCreatedBy", fields: [createdBy], references: [id])
  cropFertilizerFarmerRegistrations      CropFertilizerFarmerRegistration[]
  farmingActivities                      FarmingActivity[]
  createdAt                              DateTime                                @default(now())
  updatedAt                              DateTime                                @updatedAt
}

model Crop {
  id                           String                        @id @default(uuid())
  name                         String                        @unique
  createdBy                    String
  creator                      User                          @relation("CropCreatedBy", fields: [createdBy], references: [id])
  cropType                     CropType[]
  diseases                     Disease[]
  pests                        Pest[]
  cropMedicines                CropMedicine[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}
model CropType{
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique
  cropId   String   @unique
  crop      Crop @relation(fields: [cropId], references: [id])
  seasons   Season[]
  seedStrains SeedStrain[]
  cropFarmerRegistrations      CropFarmerRegistration[]
  cooperativeCropRegistrations CooperativeCropRegistration[]
}

model Season{
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  plantationArea                    Float
  seeds                             Float
  produceHarvested                  Float
  expectedYield                      Float
  startDate                         DateTime
  endDate                           DateTime
  seasonStatus                      SeasonStatus @default(ON_GOING)
  cropTypeId    String
  croType    CropType @relation(fields: [cropTypeId], references: [id])
  seedStrainId  String
  seedStrain    SeedStrain @relation(fields: [seedStrainId], references: [id])
  farmerId      String
  farmer Farmer @relation(fields: [farmerId], references: [id])
  harvestSeasonId String
  harvestSeason HarvestSeason @relation(fields: [harvestSeasonId], references: [id])
  cropFertilizerFarmerRegistrations CropFertilizerFarmerRegistration[]
  diseases                           Disease[]
  pests                              Pest[]
  harvests                           Harvest[]
  metricId                           String
  metric                             Metric @relation(fields: [metricId], references: [id])
  farmingActivities                  FarmingActivity[]
  
}

model Animal {
  id                             String                          @id @default(uuid())
  name                           String
  createdBy                      String
  creator                        User                            @relation("AnimalCreatedBy", fields: [createdBy], references: [id])
  animalProducts                 AnimalProduct[]
  animalFarmerRegistrations      AnimalFarmerRegistration[]
  slaughterAnimalRegistrations   SlaughterAnimalRegistration[]
  breeds                         Breed[]
  animalMedicines                AnimalMedicine[]
  animalVaccinations             AnimalVaccine[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model AnimalProduct {
  id                                    String                                 @id @default(uuid())
  name                                  String
  animalId                              String
  animal                                Animal                                 @relation(fields: [animalId], references: [id])
  farmerAnimalRegistrationProduces      FarmerAnimalRegistrationProduce[]
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
}

model Farmer {
  id                        String                     @id @default(uuid())
  userId                    String                     @unique
  user                      User                       @relation(fields: [userId], references: [id])
  cropFarmerRegistrations   CropFarmerRegistration[]
  animalFarmerRegistrations AnimalFarmerRegistration[]
  seasons                   Season[]
  cooperative              Cooperative? @relation(fields: [cooperativeId], references: [id])
  cooperativeId            String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Cooperative {
  id                             String                          @id @default(uuid())
  name                           String
  telephone                      String
  registrationNumber              String
  membersNumber                  Int
  Location                       Location                       @relation(fields: [locationId], references: [id])
  locationId                       Int
  farmers                        Farmer[]
  cooperativeCropRegistrations   CooperativeCropRegistration[]
  type                           CooperativeType
  cooperativeManager             User                          @relation(fields: [cooperativeManagerId], references: [id])
  cooperativeManagerId           String
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model SlaughterHouse {
  id                           String                        @id @default(uuid())
  name                         String
  telephone                    String
  userId                       String?
  user                         User?                          @relation(fields: [userId], references: [id])
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model CropFarmerRegistration {
  id                                String                             @id @default(uuid())
  farmerId                          String
  cropTypeId                            String
  farmer                            Farmer                             @relation(fields: [farmerId], references: [id])
  cropType                              CropType                               @relation(fields: [cropTypeId], references: [id])
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
}
model CooperativeCropRegistration {
  id                                String                             @id @default(uuid())
  cooperativeId                          String
  cropTypeId                            String
  cooperative                            Cooperative                             @relation(fields: [cooperativeId], references: [id])
  cropType                              CropType                               @relation(fields: [cropTypeId], references: [id])
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
}


model CropFertilizerFarmerRegistration {
  id                       String                 @id @default(uuid())
  fertilizerId             String
  seasonId String
  amount                   Float
  measurementId            String
  measurement              Metric            @relation(fields: [measurementId], references: [id])              
  feterlizer               Feterlizer             @relation(fields: [fertilizerId], references: [id])
  season                   Season @relation(fields: [seasonId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

