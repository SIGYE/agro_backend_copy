model FarmerAnimalRegistrationProduce {
  id                       String                @id @default(uuid())
  LivestockRegistrationId  String
  animalProductId          String
  amount                   Int
  measurements             String
  animalFarmerRegistration LiveStockRegistration @relation(fields: [LivestockRegistrationId], references: [id], onDelete: Cascade)
  animalProduct            AnimalProduct         @relation(fields: [animalProductId], references: [id], onDelete: Cascade)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
}

model Breed {
  id                           String                        @id @default(uuid())
  animalId                     String
  breedName                    String
  animal                       Animal                        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  liveStockRegistrations       LiveStockRegistration[]
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model SlaughterAnimalRegistration {
  id                     String                  @id @default(uuid())
  animalId               String
  liveStockId            String                  @unique
  breedId                String
  slaughterHouse         String
  age                    Int
  weight                 Int
  healthStatus           HealthStatus
  animal                 Animal                  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  liveStock              LiveStockRegistration   @relation(fields: [liveStockId], references: [id], onDelete: Cascade)
  breed                  Breed                   @relation(fields: [breedId], references: [id], onDelete: Cascade)
  slaughterHouseRelation SlaughterHouse          @relation(fields: [slaughterHouse], references: [id], onDelete: Cascade)
  slaughterRegistrations SlaughterRegistration[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model SlaughterRegistration {
  id                            String                      @id @default(uuid())
  slaughterAnimalRegistrationId String
  slaughterDate                 DateTime
  preSlaughterWeight            Int
  postSlaughterWeight           Int
  slaughterAnimalRegistration   SlaughterAnimalRegistration @relation(fields: [slaughterAnimalRegistrationId], references: [id], onDelete: Cascade)
  animalSlaughterProducts       AnimalSlaughterProduct[]
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model SlaughterProducts {
  id                      String                   @id @default(uuid())
  productName             String
  animalSlaughterProducts AnimalSlaughterProduct[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model AnimalSlaughterProduct {
  id                      String                @id @default(uuid())
  slaughterRegistrationId String
  productId               String
  slaughterRegistration   SlaughterRegistration @relation(fields: [slaughterRegistrationId], references: [id], onDelete: Cascade)
  product                 SlaughterProducts     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model Agronomy {
  id            String   @id @default(uuid())
  userId        String
  locationName  String
  locationLevel Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Veterinary {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Umufashamyumvire {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HarvestSeason {
  id           String       @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  seasons      Season[]
  seasonStatus SeasonStatus
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}


model SeedStrain{
  id        String   @id @default(uuid())
  name      String
  seedType   String?
  cropTypeId String
  cropType   CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  seasons    Season[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Harvest {
  id          String   @id @default(uuid())
  name        String
  amount      Float
  harvestDate DateTime
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CropListing {
  id               String       @id @default(uuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  farmerId         String?
  cooperativeId    String?
  farmer           Farmer?      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cooperative      Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  cropTypeId       String
  cropType         CropType     @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  pricePerKg       Float
  currency         String       @default("RWF")
  totalAvailableKg Float
  availableKg      Float
  minimumOrderKg   Float        @default(1)
  locationId       Int
  location         Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isActive         Boolean      @default(true)
  orderItems       OrderItem[]
  favorites        Favorite[]

  @@unique([farmerId, cropTypeId])
  @@unique([cooperativeId, cropTypeId])
  @@index([isActive])
  @@index([pricePerKg])
}

model Order {
  id                      String               @id @default(uuid())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  buyerId                 String
  buyer                   Buyer                @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade) // References Buyer
  farmerId                String?
  cooperativeId           String?
  farmer                  Farmer?              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cooperative             Cooperative?         @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  orderType               OrderType
  orderNumber             String               @unique
  itemsSubtotal           Float                @default(0)
  deliveryFee             Float                @default(0)
  platformFee             Float                @default(0)
  taxAmount               Float                @default(0)
  totalAmount             Float
  currency                String               @default("RWF")
  status                  OrderStatus          @default(PENDING)
  deliveryAddress         String?
  deliveryDate            DateTime?
  deliveryNotes           String?
  buyerPickupConfirmedAt  DateTime?
  sellerPickupConfirmedAt DateTime?
  orderItems              OrderItem[]
  statusHistory           OrderStatusHistory[]
  paymentTransactions     PaymentTransaction[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cropListingId String
  cropListing   CropListing @relation(fields: [cropListingId], references: [id], onDelete: Cascade)
  quantityKg    Float
  unitPrice     Float
  totalPrice    Float
  cropTypeId    String
  cropTypeName  String
  cropName      String
  sellerName    String
  sellerType    OrderType

  @@index([orderId])
  @@index([cropListingId])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  createdAt       DateTime    @default(now())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  notes           String?
  changedByUserId String
  changedByUser   User        @relation("OrderStatusChanges", fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptNumber    Int           @default(1)
  status           PaymentStatus
  method           PaymentMethod
  amount           Float
  currency         String        @default("RWF")
  momoPhoneNumber  String?
  cardLast4        String?
  notes            String?
  metadata         Json?
  recordedByUserId String?
  recordedByUser   User?         @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipientUserId String
  recipient       User             @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actor           User?            @relation("UserNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type            NotificationType
  title           String
  message         String
  data            Json?
  readAt          DateTime?

  @@index([recipientUserId])
  @@index([readAt])
  @@index([createdAt])
}

model Metric {
  id                               String                             @id @default(uuid())
  name                             String
  unit                             String
  seasons                          Season[]
  metricType                       MetricType?
  baseMetricId                     String?
  baseMetric                       Metric?                            @relation("MetricToBaseMetric", fields: [baseMetricId], references: [id], onDelete: Cascade)
  derivedMetrics                   Metric[]                           @relation("MetricToBaseMetric")
  coefficient                      Float?
  cropFertilizerFarmerRegistration CropFertilizerFarmerRegistration[]
  FarmingActivity                  FarmingActivity[]
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
}

model FarmingActivity {
  id          String       @id @default(uuid())
  date        DateTime
  activity    Activities
  seasonId    String
  season      Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  medicines   Medicine[]
  vaccines    Vaccine[]
  fertilizers Feterlizer[]
  diseases    Disease[]
  pests       Pest[]
  metrics     Metric[]
  amount      Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Medicine {
  id                String            @id @default(uuid())
  name              String
  cropMedicines     CropMedicine[]
  animalMedicines   AnimalMedicine[]
  farmingActivities FarmingActivity[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Vaccine {
  id                String            @id @default(uuid())
  name              String
  animalVaccines    AnimalVaccine[]
  farmingActivities FarmingActivity[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CropMedicine {
  id         String   @id @default(uuid())
  cropId     String
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnimalMedicine {
  id         String   @id @default(uuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnimalVaccine {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineId String
  vaccine   Vaccine  @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Activities {
  VACCINATION
  VITAMIN
  MEDICINE
  FERTILIZATION
  MEDICATION
}

enum MetricType {
  STANDARD
  DERIVED
}
