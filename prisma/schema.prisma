generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum CooperativeType {
  ITSINDA
  COOPERATIVE
}

enum HealthStatus {
  HEALTHY
  SICK
  RECOVERING
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum Purpose {
  DAIRY
  MEAT
  WORK
  OTHER
}

enum DiseaseType {
  LIVESTOCK
  CROP
  FUNGAL     
  VIRAL      
  BACTERIAL   
  OTHER     
}

enum PestType {
  LIVESTOCK
  CROP
  INSECT     
  NEMATODE    
  OTHER      
}

enum AnimalState {
  HEALTHY
  SICK
  SLAUGHTERED
  DEAD
}

enum SeasonStatus {
  ON_GOING
  ENDED
}

enum CollectiveType {
  COLLECTIVE
  NON_COLLECTIVE
}

enum FarmerProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

enum OrderType {
  FARMER
  COLLECTIVE_COOPERATIVE
  NON_COLLECTIVE_COOPERATIVE
}

enum PaymentMethod {
  MOMO
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationType {
  ORDER_REQUEST
  ORDER_ACCEPTED
  ORDER_REJECTED
  PAYMENT_REQUIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_STATUS_CHANGED
  PROFILE_CHANGE_REQUESTED
  PROFILE_CHANGE_APPROVED
  PROFILE_CHANGE_REJECTED
}

enum BusinessType {
  RESTAURANT
  RETAILER
  PROCESSOR
  WHOLESALER
  EXPORTER
  INSTITUTION
  COOPERATIVE
  INDIVIDUAL
  FARMER_TO_FARMER
  MANUFACTURER
  ONLINE_PLATFORM
  CATERER
  BAKERY
  BUTCHER
  DISTRIBUTOR
  OTHER
}

enum PreferredPayment {
  MOBILE_MONEY
  CASH
  BANK_TRANSFER
  OTHER
}

model User {
  id                  String             @id @default(uuid())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  username            String             @unique
  email               String?            @unique
  telephone           String?            @unique
  firstName           String
  lastName            String
  gender              Gender?
  dob                 DateTime?
  nationalId          String?            @unique
  password            String
  otp                 String?
  otpExpiresAt        DateTime?
  otpUsedAt           DateTime?
  code                String?
  isDefaultPassword   Boolean            @default(false)
  activeRole          String?
  roleId              String
  role                Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status              Status             @default(ACTIVE)
  resetCodeExpires    DateTime?
  location            Location?          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId          Int?
  country             Int?
  farmer              Farmer[]
  agronomies          Agronomy[]
  veterinaries        Veterinary[]
  umufashamyumvire    Umufashamyumvire[]
  slaughters          SlaughterHouse[]
  cooperativeManager  Cooperative[]
  locationChildrenIds String?

  diseases                     Disease[]                    @relation("DiseaseCreatedBy")
  pests                        Pest[]                       @relation("PestCreatedBy")
  vaccinations                 Vaccination[]                @relation("VaccinationCreatedBy")
  vitamins                     Vitamin[]                    @relation("VitaminCreatedBy")
  feterlizers                  Feterlizer[]                 @relation("FeterlizerCreatedBy")
  crops                        Crop[]                       @relation("CropCreatedBy")
  animals                      Animal[]                     @relation("AnimalCreatedBy")
  orderStatusChanges           OrderStatusHistory[]         @relation("OrderStatusChanges")
  buyerProfile                 Buyer?                       @relation("BuyerProfile")
  notifications                Notification[]               @relation("UserNotifications")
  notificationsSent            Notification[]               @relation("UserNotificationActor")
  paymentTransactionsRecorded  PaymentTransaction[]         @relation("PaymentRecordedBy")
  farmerProfileChangeRequests  FarmerProfileChangeRequest[] @relation("FarmerProfileChangeRequestRequester")
  farmerProfileChangeApprovals FarmerProfileChangeRequest[] @relation("FarmerProfileChangeRequestApprover")

  @@map("user")
}

model Buyer {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation("BuyerProfile", fields: [userId], references: [id], onDelete: Cascade)
  businessName     String?
  businessType     BusinessType? // Use the enum
  tin              String?
  address          String?
  favorites        Favorite[]
  orders           Order[]           @relation("BuyerOrders") // Orders belong to Buyer
  preferredPayment PreferredPayment? // Use the enum
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Favorite {
  id          String       @id @default(uuid())
  buyerId     String
  buyer       Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listingId   String?
  cropListing CropListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([buyerId, listingId]) // Prevent duplicate favorites
}

model Role {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique
  users     User[]

  @@map("role")
}

model locationLevel {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order_number Int
  name         String     @unique
  code         String     @unique
  locations    Location[]

  @@map("location_level")
}

model Location {
  id                Int                   @id @default(autoincrement())
  createdAt         DateTime?             @default(now())
  updatedAt         DateTime?             @updatedAt
  locationId        Int?
  parentLocation    Location?             @relation("LocationToLocation", fields: [locationId], references: [id], onDelete: Cascade)
  childrenLocations Location[]            @relation("LocationToLocation")
  name              String
  locationLevel     locationLevel         @relation(fields: [locationLevelId], references: [id], onDelete: Cascade)
  locationLevelId   Int
  users             User[]
  cooperatives      Cooperative[]
  locationLevelName Location_Level_Name[]
  cropListings      CropListing[]

  @@map("location")
}

model Location_Level_Name {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order_number Int
  countryId    Int
  country      Location @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name         String
  code         String
}

model Disease {
  id                String            @id @default(uuid())
  name              String
  createdBy         String
  creator           User               @relation("DiseaseCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  specificType   String?
  causativeAgent String?
  animals        Animal[]
  crops             Crop[]
  seasons           Season[]
  type              DiseaseType
  farmingActivities FarmingActivity[]
  medication        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Pest {
  id                String            @id @default(uuid())
  name              String
  createdBy         String
  creator           User              @relation("PestCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  animals           Animal[]
  crops             Crop[]
  seasons           Season[]
  farmingActivities FarmingActivity[]
  type              PestType
  medication        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Vaccination {
  id                    String                 @id @default(uuid())
  name                  String
  createdBy             String
  creator               User                   @relation("VaccinationCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  liveStockVaccinations LiveStockVaccination[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Vitamin {
  id                String              @id @default(uuid())
  name              String
  createdBy         String
  creator           User                @relation("VitaminCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  liveStockVitamins LiveStockVitamins[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Feterlizer {
  id                                String                             @id @default(uuid())
  name                              String
  createdBy                         String
  creator                           User                               @relation("FeterlizerCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  cropFertilizerFarmerRegistrations CropFertilizerFarmerRegistration[]
  crops                             Crop[]
  farmingActivities                 FarmingActivity[]
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
}

model Crop {
  id            String         @id @default(uuid())
  name          String?
  names         CropNames[]
  createdBy     String
  creator       User           @relation("CropCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  cropType      CropType[]
  diseases      Disease[]
  pests         Pest[]
  country       Int?
  cropMedicines CropMedicine[]
  fertilisers   Feterlizer[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cooperativeId String?
  cooperative   Cooperative?   @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
}

model CropNames {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  languageName String
  languageCode String
  cropId       String
  crop         Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
}

model CropType {
  id                           String                        @id @default(uuid())
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  name                         String                        @unique
  cropId                       String
  crop                         Crop                          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  seasons                      Season[]
  seedStrains                  SeedStrain[]
  cropFarmerRegistrations      CropFarmerRegistration[]
  cooperativeCropRegistrations CooperativeCropRegistration[]
  cropListings                 CropListing[]
}

model Season {
  id                                String                             @id @default(uuid())
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  name                              String
  plantationArea                    Float
  seeds                             Float
  produceHarvested                  Float
  expectedYield                     Float
  startDate                         String
  endDate                           String
  seasonStatus                      SeasonStatus                       @default(ON_GOING)
  cropTypeId                        String
  cropType                          CropType                           @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  seedStrainId                      String
  seedStrain                        SeedStrain                         @relation(fields: [seedStrainId], references: [id], onDelete: Cascade)
  farmerId                          String?
  farmer                            Farmer?                            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cooperativeId                     String?
  cooperative                       Cooperative?                       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  harvestSeasonId                   String
  harvestSeason                     HarvestSeason                      @relation(fields: [harvestSeasonId], references: [id], onDelete: Cascade)
  cropFertilizerFarmerRegistrations CropFertilizerFarmerRegistration[]
  diseases                          Disease[]
  pests                             Pest[]
  harvests                          Harvest[]
  metricId                          String
  metric                            Metric                             @relation(fields: [metricId], references: [id], onDelete: Cascade)
  farmingActivities                 FarmingActivity[]
}

model Animal {
  id                           String                        @id @default(uuid())
  name                         String?
  createdBy                    String
  creator                      User                          @relation("AnimalCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  animalProducts               AnimalProduct[]
  animalFarmerRegistrations    AnimalFarmerRegistration[]
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  breeds                       Breed[]
  animalMedicines              AnimalMedicine[]
  animalVaccinations           AnimalVaccine[]
  diseases                     Disease[]
  pests                        Pest[]
  animalNames                  AnimalNames[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model AnimalNames {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  languageName String
  languageCode String
  animalId     String
  animal       Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model AnimalProduct {
  id                               String                            @id @default(uuid())
  name                             String
  animalId                         String
  animal                           Animal                            @relation(fields: [animalId], references: [id], onDelete: Cascade)
  farmerAnimalRegistrationProduces FarmerAnimalRegistrationProduce[]
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
}

model Farmer {
  id                        String                       @id @default(uuid())
  userId                    String                       @unique
  user                      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropFarmerRegistrations   CropFarmerRegistration[]
  animalFarmerRegistrations AnimalFarmerRegistration[]
  seasons                   Season[]
  cooperative               Cooperative?                 @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  cooperativeId             String?
  cropListings              CropListing[]
  orders                    Order[]
  profileChangeRequests     FarmerProfileChangeRequest[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
}

model FarmerProfileChangeRequest {
  id               String                           @id @default(uuid())
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  farmerId         String
  farmer           Farmer                           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  requesterUserId  String
  requester        User                             @relation("FarmerProfileChangeRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  approverUserId   String?
  approver         User?                            @relation("FarmerProfileChangeRequestApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  status           FarmerProfileChangeRequestStatus @default(PENDING)
  requestedChanges Json
  reason           String?
  resolvedAt       DateTime?
  resolutionNote   String?

  @@index([farmerId])
  @@index([requesterUserId])
  @@index([approverUserId])
  @@index([status])
  @@index([createdAt])
}

model Cooperative {
  id                           String                        @id @default(uuid())
  name                         String
  telephone                    String
  registrationNumber           String
  membersNumber                Int
  Location                     Location                      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId                   Int
  farmers                      Farmer[]
  cooperativeCropRegistrations CooperativeCropRegistration[]
  seasons                      Season[]
  type                         CooperativeType
  collectiveType               CollectiveType
  cooperativeManager           User                          @relation(fields: [cooperativeManagerId], references: [id], onDelete: Cascade)
  cooperativeManagerId         String
  cropListings                 CropListing[]
  orders                       Order[]
  crops                        Crop[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model SlaughterHouse {
  id                           String                        @id @default(uuid())
  name                         String
  telephone                    String
  userId                       String?
  user                         User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slaughterAnimalRegistrations SlaughterAnimalRegistration[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
}

model CropFarmerRegistration {
  id         String   @id @default(uuid())
  farmerId   String
  cropTypeId String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropType   CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CooperativeCropRegistration {
  id            String      @id @default(uuid())
  cooperativeId String
  cropTypeId    String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  cropType      CropType    @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CropFertilizerFarmerRegistration {
  id            String     @id @default(uuid())
  fertilizerId  String
  seasonId      String
  amount        Float
  measurementId String
  measurement   Metric     @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  feterlizer    Feterlizer @relation(fields: [fertilizerId], references: [id], onDelete: Cascade)
  season        Season     @relation(fields: [seasonId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

